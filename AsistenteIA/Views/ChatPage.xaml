<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="AsistenteIA.Views.ChatPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Title="Consultar IA"
             BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#121212}">

    <Grid Padding="20" RowDefinitions="Auto, Auto, Auto, *, Auto" RowSpacing="15">

        <!-- 1. Encabezado mejorado -->
        <VerticalStackLayout Spacing="5">
            <Label Text="Asistente Académico" 
                   FontSize="28" 
                   FontAttributes="Bold" 
                   TextColor="{AppThemeBinding Light=#2C3E50, Dark=#E0E0E0}" />
            <Label Text="¿En qué te puedo ayudar hoy?" 
                   FontSize="14" 
                   TextColor="Gray" />
        </VerticalStackLayout>

        <!-- 2. Área de entrada de texto (Prompt) -->
        <Frame Grid.Row="1" 
               Padding="0" 
               CornerRadius="12" 
               HasShadow="True" 
               BorderColor="LightGray" 
               BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}">
            <Editor Text="{Binding Prompt}" 
                    Placeholder="Escriba una consulta académica aquí..." 
                    AutoSize="TextChanges" 
                    MinimumHeightRequest="100"
                    MaximumHeightRequest="180" 
                    Margin="15,10" />
        </Frame>

        <!-- 3. Botones con jerarquía visual -->
        <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="15">
            <Button Text="Consultar" 
                    Command="{Binding AskCommand}" 
                    CornerRadius="8" 
                    BackgroundColor="#0056b3" 
                    TextColor="White" 
                    FontAttributes="Bold" />

            <Button Grid.Column="1" 
                    Text="Cancelar" 
                    Command="{Binding CancelCommand}" 
                    CornerRadius="8" 
                    BackgroundColor="#dc3545" 
                    TextColor="White" 
                    FontAttributes="Bold" />
        </Grid>

        <!-- 4. Área de respuesta (estilo burbuja de chat/documento) -->
        <Frame Grid.Row="3" 
               CornerRadius="12" 
               HasShadow="False" 
               BorderColor="#E0E0E0" 
               BackgroundColor="{AppThemeBinding Light=#e9ecef, Dark=#2b3035}"
               Padding="15">
            <ScrollView>
                <VerticalStackLayout Spacing="10">
                    <Label Text="Respuesta de la IA:" 
                           FontAttributes="Bold" 
                           TextColor="#0056b3" 
                           FontSize="14" />
                    <Label Text="{Binding Answer}" 
                           LineBreakMode="WordWrap" 
                           FontSize="15" />
                </VerticalStackLayout>
            </ScrollView>
        </Frame>

        <!-- 5. Estado y Carga -->
        <HorizontalStackLayout Grid.Row="4" 
                               Spacing="10" 
                               HorizontalOptions="Center" 
                               VerticalOptions="Center">
            <ActivityIndicator IsRunning="{Binding IsBusy}" 
                               IsVisible="{Binding IsBusy}" 
                               Color="#0056b3" />
            <Label Text="{Binding StatusMessage}" 
                   FontSize="13" 
                   TextColor="Gray" 
                   VerticalOptions="Center" />
        </HorizontalStackLayout>

    </Grid>
</ContentPage>