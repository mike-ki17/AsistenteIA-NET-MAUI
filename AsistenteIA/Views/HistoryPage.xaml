<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AsistenteIA.ViewModels"
             x:Class="AsistenteIA.Views.HistoryPage"
             Title="Historial"
             BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#121212}">

    <Grid RowDefinitions="Auto, Auto, *" Padding="20" RowSpacing="15">

        <!-- 1. Encabezado -->
        <VerticalStackLayout Spacing="5">
            <Label Text="Historial de Consultas" 
                   FontSize="28" 
                   FontAttributes="Bold" 
                   TextColor="{AppThemeBinding Light=#2C3E50, Dark=#E0E0E0}" />
            <Label Text="Revisa, filtra y administra tus preguntas anteriores" 
                   FontSize="14" 
                   TextColor="Gray" />
        </VerticalStackLayout>

        <!-- 2. Barra de búsqueda (Filtro requerido en Fase 10) -->
        <Frame Grid.Row="1" Padding="0" CornerRadius="10" HasShadow="False" BorderColor="LightGray" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}">
            <SearchBar Placeholder="Buscar consultas..." 
                       Text="{Binding SearchQuery}" 
                       SearchCommand="{Binding SearchCommand}" 
                       CancelButtonColor="#0056b3" />
        </Frame>

        <!-- 3. Lista de Historial -->
        <CollectionView Grid.Row="2" 
                        ItemsSource="{Binding Conversations}" 
                        SelectionMode="Single"
                        SelectedItem="{Binding SelectedConversation}"
                        SelectionChangedCommand="{Binding GoToDetailCommand}">

            <!-- Vista cuando no hay datos -->
            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10" Margin="0,50,0,0">
                    <Label Text="📭" FontSize="40" HorizontalOptions="Center" />
                    <Label Text="No hay consultas guardadas." TextColor="Gray" FontSize="16" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <!-- Plantilla de cada tarjeta de consulta -->
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="0,5,0,10">
                        <Frame CornerRadius="12" HasShadow="True" BorderColor="Transparent" Padding="15" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}">
                            <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto, Auto" RowSpacing="5">

                                <!-- Pregunta (Prompt) recortada a 2 líneas -->
                                <Label Text="{Binding Prompt}" 
                                       FontAttributes="Bold" 
                                       FontSize="16" 
                                       LineBreakMode="TailTruncation" 
                                       MaxLines="2" 
                                       TextColor="{AppThemeBinding Light=Black, Dark=White}" />

                                <!-- Fecha y Categoría -->
                                <Label Grid.Row="1" 
                                       Text="{Binding CreatedAt, StringFormat='{0:dd/MM/yyyy HH:mm}'}" 
                                       FontSize="12" 
                                       TextColor="Gray" />

                                <HorizontalStackLayout Grid.Row="2" Spacing="10" Margin="0,5,0,0">
                                    <Frame Padding="8,4" CornerRadius="8" BackgroundColor="#e9ecef" BorderColor="Transparent" HasShadow="False">
                                        <Label Text="{Binding Category}" FontSize="11" TextColor="#0056b3" FontAttributes="Bold" />
                                    </Frame>
                                    <Label Text="✓ Verificado" 
                                           IsVisible="{Binding IsVerified}" 
                                           TextColor="#28a745" 
                                           FontSize="12" 
                                           VerticalOptions="Center" 
                                           FontAttributes="Bold" />
                                </HorizontalStackLayout>

                                <!-- Botón Eliminar (Fase 10) -->
                                <ImageButton Grid.Column="1" 
                                             Grid.RowSpan="3" 
                                             Source="dotnet_bot.png" 
                                             Command="{Binding Source={RelativeSource AncestorType={x:Type vm:HistoryViewModel}}, Path=DeleteCommand}" 
                                             CommandParameter="{Binding .}" 
                                             BackgroundColor="Transparent" 
                                             WidthRequest="30" 
                                             HeightRequest="30" 
                                             VerticalOptions="Center">
                                    <!-- Nota: Cambia 'dotnet_bot.png' por un icono de papelera (ej. 'trash.png') si lo agregas a tu carpeta Resources/Images -->
                                </ImageButton>
                            </Grid>
                        </Frame>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>